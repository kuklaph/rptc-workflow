{
  "schema_version": 1,
  "contract_version": "2026-08-21",
  "shared_root": "shared",
  "enforce_adapter_contract_refs": true,
  "providers": {
    "claude": {
      "manifest": ".claude-plugin/plugin.json",
      "command_root": "claude/commands",
      "agent_root": "claude/agents",
      "skill_root": "skills",
      "planning": "EnterPlanMode and ExitPlanMode",
      "tracking": "TaskCreate and TaskUpdate",
      "delegation": "Task",
      "interactive_questions": "AskUserQuestion",
      "persistent_teams": true,
      "agent_installation": "Declared by the Claude plugin manifest"
    },
    "codex": {
      "manifest": ".codex-plugin/plugin.json",
      "command_root": null,
      "agent_root": "codex/agents",
      "skill_root": "codex/skills",
      "planning": "Codex plan mode and request_user_input",
      "tracking": "update_plan",
      "delegation": "spawn_agent and wait_agent",
      "interactive_questions": "request_user_input in plan mode; normal chat otherwise",
      "persistent_teams": false,
      "agent_installation": "rptc-init copies packaged TOML agents to the project or Codex home"
    }
  },
  "flows": {
    "feat": {
